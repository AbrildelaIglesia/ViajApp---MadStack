<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5">


    <LinearLayout
        android:id="@+id/barraAccesibilidad"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/fondo_barra_accesibilidad"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="ⓘ ACCESIBILIDAD"
            android:textColor="#1E5FA8"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btnReducirTexto"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="A-"
            android:textColor="#111827"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btnAumentarTexto"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="A+"
            android:textColor="#111827"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btnContraste"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="◐ Contraste"
            android:textColor="#111827"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvVozActiva"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_audio"
            android:text="🔊"
            android:textSize="14sp"
            android:contentDescription="Audio" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/barraAccesibilidad"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnVolver"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="←   Volver"
                    android:textColor="#001428"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:contentDescription="Volver" />
                <TextView
                    android:id="@+id/tvEstadoConexion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◀̸ Modo Desconectado"
                    android:textColor="#001428"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="end"
                    android:contentDescription="Modo desconectado" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="206dp"
                android:layout_height="206dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/fondo_boton_accesibilidad"
                android:elevation="2dp"
                android:clipToOutline="true">
                <ImageView
                    android:id="@+id/imgErrorConexion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/error_conexion"
                    android:contentDescription="Ilustración de un gato sin conexión" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="¡Ups! Sin conexión"
                android:textColor="#001428"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="No pudimos conectar con los servidores"
                android:textColor="#001428"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="2dp"
                android:background="@drawable/fondo_boton_accesibilidad">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="☼ Pasos recomendados para continuar"
                    android:textColor="#001428"
                    android:textSize="16sp"
                    android:paddingBottom="6dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ⓥ Verifica que el modo avión esté desactivado."
                    android:textColor="#001428"
                    android:textSize="16sp"
                    android:paddingBottom="7dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ⓥ Revisa si tienes cobertura de datos móviles o red Wi-Fi."
                    android:textColor="#001428"
                    android:textSize="16sp"
                    android:paddingBottom="7dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ⓥ Tus itinerarios guardados sin conexión siguen disponibles para consulta."
                    android:textColor="#001428"
                    android:textSize="16sp"
                    android:paddingBottom="12dp" />
                <TextView
                    android:id="@+id/btnGuiasOffline"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:text="▣ Ver guías guardadas offline                         ›"
                    android:textColor="#001428"
                    android:textSize="16sp"
                    android:contentDescription="Ver guías guardadas offline" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnReintentarConexion"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:background="@drawable/fondo_boton_accesibilidad"
                android:elevation="3dp"
                android:text="↻ Reintentar conexión"
                android:textColor="#001428"
                android:textSize="17sp"
                android:contentDescription="Reintentar conexión" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="⚝ Optimizada para TalkBack, VoiceOver y lectores de pantalla."
                android:textColor="#001428"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="30dp"
                android:background="#E8E8E8" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="¿Aún no tienes cuenta?  Regístrate aquí"
                android:textColor="#1E5FA8"
                android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:textColor="#1E5FA8"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
