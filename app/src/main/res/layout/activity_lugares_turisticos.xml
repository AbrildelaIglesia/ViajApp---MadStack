<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FAF8FF"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:background="@drawable/logo_viajapp"
                android:text=""
                android:textColor="#2563EB"
                android:textSize="25sp"
                android:contentDescription="Logo ViajAPP"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ViajAPP"
                    android:textColor="#001428"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COLECCIÓN"
                    android:textColor="#43474D"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:contentDescription="Pantalla de colecciones"/>
            </LinearLayout>


            <!-- ======================================= -->
            <!-- BOTÓN PERFIL DE USUARIO                 -->
            <!-- ======================================= -->

            <com.google.android.material.card.MaterialCardView
                android:tooltipText="Perfil"
                android:id="@+id/btnAbrirPerfil"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Menú de usuario"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#DBEAFE"
                app:strokeColor="#93C5FD"
                app:strokeWidth="2dp">

                <ImageView
                    android:id="@+id/imgIconoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:src="@drawable/ic_person"
                    app:tint="#1D4ED8"
                    android:importantForAccessibility="no" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>


    <!-- BARRA DE ACCESIBILIDAD FIJA -->
    <LinearLayout
        android:id="@+id/barraAccesibilidad"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/fondo_barra_accesibilidad"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ACCESIBILIDAD -->
        <TextView
            android:id="@+id/btnAccesibilidad"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text=" ☰  ACCESIBILIDAD"
            android:textColor="#1E5FA8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:contentDescription="Cerrar menú de accesibilidad"
            android:clickable="true"
            android:focusable="true" />

        <!-- DISMINUIR TEXTO -->
        <TextView
            android:id="@+id/btnDisminuirTexto"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="A-"
            android:textColor="#111827"
            android:textSize="12sp"
            android:textStyle="bold"
            android:contentDescription="Disminuir tamaño de letra"/>

        <!-- AUMENTAR TEXTO -->
        <TextView
            android:id="@+id/btnAumentarTexto"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="A+"
            android:textColor="#111827"
            android:textSize="16sp"
            android:textStyle="bold"
            android:contentDescription="Aumentar tamaño de letra"/>

        <!-- CONTRASTE -->
        <TextView
            android:id="@+id/btnContraste"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="◐  Contraste"
            android:textColor="#111827"
            android:textSize="11sp"
            android:textStyle="bold"
            android:contentDescription="Cambiar contraste"/>

        <!-- AUDIO -->
        <TextView
            android:id="@+id/btnAudio"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/fondo_boton_audio"
            android:gravity="center"
            android:text="🔊"
            android:textSize="14sp"
            android:contentDescription="Ir a deshabilitar talkback"/>

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/barraAccesibilidad"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mis itinerarios guardados"
                android:textColor="#0C2340"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Consultá los viajes que creaste con IA. Cada uno conserva sus días y actividades."
                android:textColor="#64748B"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvEstadoColeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Cargando itinerarios..."
                android:textColor="#475569"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/contenedorItinerarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FAF8FF"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navAccesibilidad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:contentDescription="Ir a accesibilidad">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:gravity="center"
                android:text="♿︎"
                android:textColor="#64748B"
                android:textSize="23sp"
                android:importantForAccessibility="no"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accesibilidad"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:importantForAccessibility="no"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPlanear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Ir a planear viaje">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="◎"
                android:textColor="#64748B"
                android:textSize="23sp"
                android:clickable="false"
                android:importantForAccessibility="no"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:text="Planear"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:importantForAccessibility="no"/>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/navItinerario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Ir a Itinerario" >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="▦"
                android:textColor="#64748B"
                android:textSize="23sp"
                android:clickable="false"
                android:importantForAccessibility="no"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Itinerario"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:clickable="false"
                android:importantForAccessibility="no"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navLugares"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="#EFF6FF"
            android:contentDescription="Colección, pantalla actual">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="⌖"
                android:textColor="#2563EB"
                android:textSize="23sp"
                android:clickable="false"
                android:importantForAccessibility="no"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Colección"
                android:textColor="#2563EB"
                android:textSize="11sp"
                android:clickable="false"
                android:textStyle="bold"
                android:importantForAccessibility="no"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

