<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">


    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FAF8FF"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:background="@drawable/logo_viajapp"
                android:text=""
                android:textColor="#2563EB"
                android:textSize="25sp"
                android:contentDescription="Logo ViajAPP" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ViajAPP"
                    android:textColor="#001428"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLANEAR VIAJE"
                    android:textColor="#43474D"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_icon_blue"
                android:text="●"
                android:textColor="#FFFFFF"
                android:contentDescription="Perfil" />
        </LinearLayout>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/barraAccesibilidad"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/fondo_barra_accesibilidad"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="ⓘ ACCESIBILIDAD"
            android:textColor="#1E5FA8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnReducirTexto"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="A-"
            android:textColor="#111827"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAumentarTexto"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="A+"
            android:textColor="#111827"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnContraste"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="◐ Contraste"
            android:textColor="#111827"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVozActiva"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_audio"
            android:text="🔊"
            android:textSize="14sp"
            android:contentDescription="Audio" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/barraBusqueda"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:background="@drawable/fondo_buscador"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/barraAccesibilidad"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_search"
            app:tint="#3B82F6"
            android:contentDescription="Buscar destino"/>

        <EditText
            android:id="@+id/etBuscarDestino"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Buscar localidad o destino..."
            android:textColor="#0C2340"
            android:textColorHint="#94A3B8"
            android:textSize="14sp"
            android:singleLine="true"
            android:inputType="textCapWords"
            android:imeOptions="actionSearch"
            android:padding="0dp"
            android:importantForAutofill="no"/>

        <ImageView
            android:id="@+id/btnBuscarVoz"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/fondo_boton_microfono_busqueda"
            android:src="@drawable/ic_mic"
            app:tint="#FFFFFF"
            android:contentDescription="Búsqueda por voz"/>

    </LinearLayout>



    <ScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/barraBusqueda"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="18dp">

            <!-- RESULTADOS DE BUSQUEDA DE FIREBASE -->
            <LinearLayout
                android:id="@+id/contenedorResultadosDestinos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card"
                android:padding="8dp"
                android:visibility="gone"/>



            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="154dp"
                android:background="@drawable/bg_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/imgDestino"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Fotografía del destino seleccionado" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_photo_scrim"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DESTINO SELECCIONADO"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:id="@+id/tvDestinoSeleccionado"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnCambiarDestino"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="10dp"
                    android:gravity="center"
                    android:background="@drawable/bg_circle_white"
                    android:text="●"
                    android:textColor="#64748B"
                    android:contentDescription="Cambiar destino"/>
            </FrameLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="@drawable/bg_metric_card">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:background="@drawable/bg_icon_green"
                    android:text="✓"
                    android:textColor="#15803D"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Accesibilidad de los lugares pendiente de verificar"
                        android:textColor="#0C4A6E"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Consultá las condiciones de acceso antes de viajar"
                        android:textColor="#64748B"
                        android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="Parámetros del itinerario"
                android:textColor="#0C2340"
                android:textSize="16sp"
                android:textStyle="bold"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DURACIÓN"
                    android:textColor="#64748B"
                    android:textSize="9sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvCantidadDias"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5 días"
                            android:textColor="#0C2340"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ritmo descansado"
                            android:textColor="#64748B"
                            android:textSize="10sp"/>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnMenosDias"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_stepper_minus"
                        app:backgroundTint="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="−"
                        android:textColor="#0284C7"
                        android:textSize="20sp"
                        android:stateListAnimator="@null"/>

                    <Button
                        android:id="@+id/btnMasDias"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_stepper_plus"
                        app:backgroundTint="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:stateListAnimator="@null" />
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIAJEROS"
                    android:textColor="#64748B"
                    android:textSize="9sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvCantidadViajeros"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 personas"
                            android:textColor="#0C2340"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 requerimiento de movilidad"
                            android:textColor="#64748B"
                            android:textSize="10sp"/>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnMenosViajeros"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_stepper_minus"
                        app:backgroundTint="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="−"
                        android:textColor="#0284C7"
                        android:textSize="20sp"
                        android:stateListAnimator="@null"/>

                    <Button
                        android:id="@+id/btnMasViajeros"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_stepper_plus"
                        app:backgroundTint="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:stateListAnimator="@null"/>
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="@drawable/bg_card">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRESUPUESTO ESTIMADO"
                        android:textColor="#64748B"
                        android:textSize="9sp"/>
                    <EditText
                        android:id="@+id/etPresupuesto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:inputType="number"
                        android:padding="0dp"
                        android:text="500000"
                        android:textColor="#0C2340"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alojamientos y traslados adaptados"
                        android:textColor="#64748B"
                        android:textSize="10sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:background="@drawable/bg_icon_pink"
                    android:text="$"
                    android:textColor="#F43F5E"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Intereses de viaje accesibles"
                    android:textColor="#0C2340"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvInteresesActivos"
                    android:text="3 activos"
                    android:textColor="#F43F5E"
                    android:textSize="10sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                android:text="Elegí tus intereses. La accesibilidad de cada lugar requiere confirmación."
                android:textColor="#64748B"
                android:textSize="11sp"/>

            <include android:id="@+id/interesNaturaleza" layout="@layout/item_interes_naturaleza"/>
            <include android:id="@+id/interesGastronomia" layout="@layout/item_interes_gastronomia"/>
            <include android:id="@+id/interesTrekking" layout="@layout/item_interes_trekking"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="@drawable/bg_rest_stops">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:background="@drawable/bg_circle_white"
                    android:text="⌁"
                    android:textColor="#0284C7"
                    android:textSize="22sp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Priorizar tramos cortos"
                        android:textColor="#0C2340"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Menos de 250 m entre bancos y descansos"
                        android:textColor="#64748B"
                        android:textSize="10sp"/>
                </LinearLayout>

                <Switch
                    android:id="@+id/swTramosCortos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:contentDescription="Priorizar tramos cortos"/>
            </LinearLayout>


            <Button
                android:id="@+id/btnCrearViajeIA"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_ai"
                app:backgroundTint="@null"
                android:minHeight="0dp"
                android:padding="8dp"
                android:stateListAnimator="@null"
                android:text="✧ Crear viaje accesible con IA"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="⚡ Itinerario orientativo; verificá la accesibilidad antes de viajar"
                android:textColor="#64748B"
                android:textSize="10sp"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_ai_preview"
                android:padding="14dp">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ai_icon"
                    android:text="✿"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Motor IA Adaptativo"
                        android:textColor="#0C4A6E"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Sugerirá actividades según tus preferencias sin asumir accesibilidad no verificada."
                        android:textColor="#64748B"
                        android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>


    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FAF8FF"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navPlanear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="#EFF6FF"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="◎"
                android:textColor="#2563EB"
                android:textSize="23sp"
                android:clickable="false"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:text="Planear"
                android:textColor="#2563EB"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAccesibilidad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:gravity="center"
                android:text="♿︎"
                android:textColor="#64748B"
                android:textSize="23sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accesibilidad"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navItinerario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="▦"
                android:textColor="#64748B"
                android:textSize="23sp"
                android:clickable="false"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Itinerario"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:clickable="false"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navLugares"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
