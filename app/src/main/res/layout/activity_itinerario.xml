<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8FF">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FAF8FF"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:background="@drawable/logo_viajapp"
                android:text=""
                android:textColor="#2563EB"
                android:textSize="25sp"
                android:contentDescription="Logo ViajAPP" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ViajAPP"
                    android:textColor="#001428"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ITINERARIO"
                    android:textColor="#43474D"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>


            <!-- ======================================= -->
            <!-- BOTÓN PERFIL DE USUARIO                 -->
            <!-- ======================================= -->

            <com.google.android.material.card.MaterialCardView
                android:tooltipText="Perfil"
                android:id="@+id/btnAbrirPerfil"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Abrir menú de mi cuenta"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#DBEAFE"
                app:strokeColor="#93C5FD"
                app:strokeWidth="2dp">

                <ImageView
                    android:id="@+id/imgIconoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:src="@drawable/ic_person"
                    app:tint="#1D4ED8"
                    android:importantForAccessibility="no" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>


    <!-- BARRA DE ACCESIBILIDAD FIJA -->
    <LinearLayout
        android:id="@+id/barraAccesibilidad"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/fondo_barra_accesibilidad"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ACCESIBILIDAD -->
        <TextView
            android:id="@+id/btnAccesibilidad"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text=" ☰  ACCESIBILIDAD"
            android:textColor="#1E5FA8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:contentDescription="Cerrar menú de accesibilidad"
            android:clickable="true"
            android:focusable="true" />

        <!-- DISMINUIR TEXTO -->
        <TextView
            android:id="@+id/btnDisminuirTexto"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="A-"
            android:textColor="#111827"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- AUMENTAR TEXTO -->

        <!-- CONTRASTE -->

        <TextView
            android:id="@+id/btnAumentarTexto"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:gravity="center"
            android:text="A+"
            android:textColor="#111827"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnContraste"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="◐  Contraste"
            android:textColor="#111827"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- AUDIO -->
        <TextView
            android:id="@+id/btnAudio"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/fondo_boton_audio"
            android:gravity="center"
            android:text="🔊"
            android:textSize="14sp"
            android:contentDescription="Audio" />

    </LinearLayout>


    <ScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraAccesibilidad"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/contenidoGenerado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvTituloItinerarioGenerado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#EFF6FF"
                    android:padding="16dp"
                    android:textColor="#1E293B"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <!-- Clima actual: tarjeta compacta, estilo del ejemplo -->
                <LinearLayout
                    android:id="@+id/tarjetaClima"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#F0F9FF"
                    android:clickable="true"
                    android:contentDescription="Consultar nuevamente el clima del destino"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/iconoClima"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="#FED7AA"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:text="☀"
                        android:textColor="#C2410C"
                        android:textSize="28sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvClimaTitulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Consultando clima..."
                            android:textColor="#0F172A"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvClimaDetalle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Obteniendo condiciones meteorológicas del destino."
                            android:textColor="#475569"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#FFF1D6"
                    android:padding="12dp"
                    android:text="Itinerario sugerido por IA. La accesibilidad de cada lugar debe verificarse antes de viajar."
                    android:textColor="#5A5146"
                    android:textSize="13sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/barraDiasGenerados"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Preparativos del paseo: selección independiente para cada día -->
                <LinearLayout
                    android:id="@+id/tarjetaPreparativos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#EFF6FF"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Prepará tu paseo"
                        android:textColor="#1E293B"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProgresoPreparativos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 de 8 elementos preparados"
                        android:textColor="#475569"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/listaPreparativos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tarjetasActividades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contenidoEjemplo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#EFF6FF"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✧ EJEMPLO DE ITINERARIO • DATOS ILUSTRATIVOS"
                        android:textColor="#E11D48"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Itinerario Bariloche 5 Días"
                        android:textColor="#1E293B"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="#DCFCE7"
                        android:padding="8dp"
                        android:text="♿ 100% Accesible para Silla de Ruedas"
                        android:textColor="#166534"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnAudioItinerario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#2563EB"
                    android:minHeight="64dp"
                    android:padding="14dp"
                    android:text="🔊 Escuchar itinerario completo&#10;Audio descriptivo de 4 minutos"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="10dp"
                            android:background="#F43F5E"
                            android:gravity="center"
                            android:text="DÍA&#10;1"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="10dp"
                            android:background="#F1F5F9"
                            android:gravity="center"
                            android:text="DÍA&#10;2"
                            android:textColor="#475569"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="10dp"
                            android:background="#F1F5F9"
                            android:gravity="center"
                            android:text="DÍA&#10;3"
                            android:textColor="#475569"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="10dp"
                            android:background="#F1F5F9"
                            android:gravity="center"
                            android:text="DÍA&#10;4"
                            android:textColor="#475569"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="#F1F5F9"
                            android:gravity="center"
                            android:text="DÍA&#10;5"
                            android:textColor="#475569"
                            android:textSize="14sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#F0F9FF"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="#FED7AA"
                        android:gravity="center"
                        android:text="☀"
                        android:textColor="#C2410C"
                        android:textSize="24sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="19°C • Despejado • Sin viento"
                            android:textColor="#0F172A"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Condición óptima para paseos exteriores en silla de ruedas y senderos pavimentados."
                            android:textColor="#475569"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#FFFFFF"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="10:00 AM • Punto Panorámico"
                        android:textColor="#2563EB"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/mirador_bahia_lopez"
                        android:contentDescription="Mirador Bahía López"
                        android:gravity="center"
                        android:textColor="#1D4ED8"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Circuito Chico - Mirador Bahía López"
                        android:textColor="#0F172A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Acceso continuo sin desniveles pronunciados. Pavimento consolidado y barandas de seguridad a 90 cm de altura."
                        android:textColor="#475569"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="✓ Rampa suave     ✓ Sin escaleras&#10;✓ Baño accesible certificado     ✓ Tránsito llano 200m"
                        android:textColor="#166534"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnAudioMirador"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="#EFF6FF"
                        android:text="▶ Escuchar guía de audio"
                        android:textAllCaps="false"
                        android:textColor="#1D4ED8"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#FFFFFF"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="01:30 PM • Gastronomía Patagónica"
                        android:textColor="#2563EB"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/restaurante_el_refugio"
                        android:contentDescription="Restaurante patagónico El Refugio"
                        android:gravity="center"
                        android:textColor="#9F1239"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Restaurante Patagónico “El Refugio”"
                        android:textColor="#0F172A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Mesa reservada con altura libre inferior de 75 cm para silla. Carta en braille y menú con audioguía disponible."
                        android:textColor="#475569"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="✓ Entrada a nivel     ✓ Sanitario adaptado con barras&#10;✓ Estacionamiento reservado"
                        android:textColor="#166534"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#FFFFFF"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="04:00 PM • Paseo Natural"
                        android:textColor="#2563EB"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bosque_municipal"
                        android:contentDescription="Paseo Entablonado Bosque Municipal"
                        android:gravity="center"
                        android:textColor="#166534"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Paseo Entablonado Bosque Municipal"
                        android:textColor="#0F172A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Sendero sensorial con listones longitudinales antiderrapantes. Zonas de descanso con sombra y apoyabrazos dobles."
                        android:textColor="#475569"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="✓ Pasarela de madera sin desniveles&#10;✓ Bancos de descanso cada 50 m"
                        android:textColor="#166534"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnVerMapa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="#F43F5E"
                    android:minHeight="60dp"
                    android:text="⌖ Ver mapa de rutas sin barreras arquitectónicas"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FAF8FF"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navAccesibilidad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:gravity="center"
                android:text="♿︎"
                android:textColor="#64748B"
                android:textSize="23sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accesibilidad"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPlanear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="◎"
                android:textColor="#64748B"
                android:textSize="23sp"
                android:clickable="false"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:text="Planear"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>



        <LinearLayout
            android:id="@+id/navItinerario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="#EFF6FF"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="▦"
                android:textColor="#2563EB"
                android:textSize="23sp"
                android:clickable="false"/>

