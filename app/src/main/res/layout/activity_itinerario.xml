<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8FF">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FAF8FF"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:background="@drawable/logo_viajapp"
                android:text=""
                android:textColor="#2563EB"
                android:textSize="25sp"
                android:contentDescription="Logo ViajAPP" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ViajAPP"
                    android:textColor="#001428"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACCESIBLE"
                    android:textColor="#43474D"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:background="#60A5FA"
                android:text="●"
                android:textColor="#FFFFFF"
                android:contentDescription="Perfil" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/barraAccesibilidad"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/fondo_barra_accesibilidad"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="ⓘ ACCESIBILIDAD"
            android:textColor="#1E5FA8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnReducirTexto"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="A-"
            android:textColor="#111827"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAumentarTexto"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="A+"
            android:textColor="#111827"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnContraste"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="◐ Contraste"
            android:textColor="#111827"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVozActiva"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_audio"
            android:text="🔊"
            android:textSize="14sp"
            android:contentDescription="Audio" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/barraAccesibilidad"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="#EFF6FF">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✧ GENERADO POR IA • VERIFICADO"
                    android:textColor="#E11D48"
                    android:textStyle="bold"
                    android:textSize="11sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Itinerario Bariloche 5 Días"
                    android:textColor="#1E293B"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="8dp"
                    android:background="#DCFCE7"
                    android:text="♿ 100% Accesible para Silla de Ruedas"
                    android:textColor="#166534"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAudioItinerario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:layout_marginTop="14dp"
                android:padding="14dp"
                android:backgroundTint="#2563EB"
                android:text="🔊 Escuchar itinerario completo&#10;Audio descriptivo de 4 minutos"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="56dp" android:layout_height="56dp" android:layout_marginEnd="10dp" android:gravity="center" android:background="#F43F5E" android:text="DÍA&#10;1" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" />
                    <TextView android:layout_width="56dp" android:layout_height="56dp" android:layout_marginEnd="10dp" android:gravity="center" android:background="#F1F5F9" android:text="DÍA&#10;2" android:textColor="#475569" android:textSize="14sp" />
                    <TextView android:layout_width="56dp" android:layout_height="56dp" android:layout_marginEnd="10dp" android:gravity="center" android:background="#F1F5F9" android:text="DÍA&#10;3" android:textColor="#475569" android:textSize="14sp" />
                    <TextView android:layout_width="56dp" android:layout_height="56dp" android:layout_marginEnd="10dp" android:gravity="center" android:background="#F1F5F9" android:text="DÍA&#10;4" android:textColor="#475569" android:textSize="14sp" />
                    <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:background="#F1F5F9" android:text="DÍA&#10;5" android:textColor="#475569" android:textSize="14sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="#F0F9FF">
                <TextView android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:background="#FED7AA" android:text="☀" android:textColor="#C2410C" android:textSize="24sp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="19°C • Despejado • Sin viento" android:textColor="#0F172A" android:textStyle="bold" android:textSize="14sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Condición óptima para paseos exteriores en silla de ruedas y senderos pavimentados." android:textColor="#475569" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="10:00 AM • Punto Panorámico" android:textColor="#2563EB" android:textStyle="bold" android:textSize="13sp" />
                <TextView android:layout_width="match_parent" android:layout_height="160dp" android:layout_marginTop="10dp" android:gravity="center" android:background="@drawable/mirador_bahia_lopez"  android:textColor="#1D4ED8" android:textSize="14sp" android:contentDescription="Mirador Bahía López" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Circuito Chico - Mirador Bahía López" android:textColor="#0F172A" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Acceso continuo sin desniveles pronunciados. Pavimento consolidado y barandas de seguridad a 90 cm de altura." android:textColor="#475569" android:textSize="13sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="✓ Rampa suave     ✓ Sin escaleras&#10;✓ Baño accesible certificado     ✓ Tránsito llano 200m" android:textColor="#166534" android:textSize="12sp" />
                <Button android:id="@+id/btnAudioMirador" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:backgroundTint="#EFF6FF" android:text="▶ Escuchar guía de audio" android:textColor="#1D4ED8" android:textAllCaps="false" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="01:30 PM • Gastronomía Patagónica" android:textColor="#2563EB" android:textStyle="bold" android:textSize="13sp" />
                <TextView android:layout_width="match_parent" android:layout_height="160dp" android:layout_marginTop="10dp" android:gravity="center" android:background="@drawable/restaurante_el_refugio"  android:textColor="#9F1239" android:textSize="14sp" android:contentDescription="Restaurante patagónico El Refugio" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Restaurante Patagónico “El Refugio”" android:textColor="#0F172A" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Mesa reservada con altura libre inferior de 75 cm para silla. Carta en braille y menú con audioguía disponible." android:textColor="#475569" android:textSize="13sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="✓ Entrada a nivel     ✓ Sanitario adaptado con barras&#10;✓ Estacionamiento reservado" android:textColor="#166534" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="04:00 PM • Paseo Natural" android:textColor="#2563EB" android:textStyle="bold" android:textSize="13sp" />
                <TextView android:layout_width="match_parent" android:layout_height="160dp" android:layout_marginTop="10dp" android:gravity="center" android:background="@drawable/bosque_municipal" android:textColor="#166534" android:textSize="14sp" android:contentDescription="Paseo Entablonado Bosque Municipal"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Paseo Entablonado Bosque Municipal" android:textColor="#0F172A" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Sendero sensorial con listones longitudinales antiderrapantes. Zonas de descanso con sombra y apoyabrazos dobles." android:textColor="#475569" android:textSize="13sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="✓ Pasarela de madera sin desniveles&#10;✓ Bancos de descanso cada 50 m" android:textColor="#166534" android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnVerMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#F43F5E"
                android:text="⌖ Ver mapa de rutas sin barreras arquitectónicas"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FAF8FF"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:id="@+id/navPlanear" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="⌖" android:textColor="#43474D" android:textSize="23sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Planear" android:textColor="#43474D" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navAccesibilidad" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="♿" android:textColor="#43474D" android:textSize="23sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Accesibilidad" android:textColor="#43474D" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navItinerario" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="#EFF6FF">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="▦" android:textColor="#2563EB" android:textSize="23sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Itinerario" android:textColor="#2563EB" android:textStyle="bold" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navLugares" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="⌖" android:textColor="#43474D" android:textSize="23sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lugares" android:textColor="#43474D" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>