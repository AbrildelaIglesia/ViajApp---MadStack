<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tarjetaEditarPerfil"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="22dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#B6C6E3"
    app:strokeWidth="2dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- VOLVER -->
            <TextView
                android:id="@+id/txtVolverMiCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹ Volver a mi cuenta"
                android:textColor="#2563EB"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingBottom="10dp" />

            <!-- TÍTULO -->
            <TextView
                android:id="@+id/txtTituloEditarPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar perfil"
                android:textColor="#111827"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- SUBTÍTULO -->
            <TextView
                android:id="@+id/txtSubtituloEditarPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Actualizá tus datos personales de forma simple y segura."
                android:textColor="#64748B"
                android:textSize="14sp" />

            <!-- SEPARADOR -->
            <View
                android:id="@+id/divisorEditarPerfilSuperior"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="#E2E8F0" />

            <!-- NOMBRE Y APELLIDO -->
            <TextView
                android:id="@+id/lblNombreApellidoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre y apellido"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutNombreApellidoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nombre y apellido"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#F8FAFC"
                app:boxStrokeColor="#93C5FD"
                app:boxCornerRadiusTopStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusBottomEnd="18dp"
                app:hintTextColor="#64748B"
                android:layout_marginBottom="18dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNombreApellidoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:textColor="#111827"
                    android:textColorHint="#64748B"
                    android:textSize="15sp"
                    android:inputType="textPersonName"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- CORREO -->
            <TextView
                android:id="@+id/lblCorreoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Correo electrónico"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutCorreoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Correo electrónico"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#F8FAFC"
                app:boxStrokeColor="#93C5FD"
                app:boxCornerRadiusTopStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusBottomEnd="18dp"
                app:hintTextColor="#64748B">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtCorreoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:textColor="#111827"
                    android:textColorHint="#64748B"
                    android:textSize="15sp"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- BOTÓN -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarEditarPerfil"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:text="Guardar cambios"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#2563EB"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_save"
                app:iconTint="#FFFFFF"
                app:iconSize="20dp"
                app:iconPadding="10dp"
                app:iconGravity="textStart"/>


            <!-- TEXTO FINAL -->
            <TextView
                android:id="@+id/txtPieEditarPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Tus cambios se guardarán en tu cuenta de ViajAPP."
                android:textColor="#64748B"
                android:textSize="12sp"
                android:gravity="center" />

        </LinearLayout>
    </ScrollView>

</com.google.android.material.card.MaterialCardView>