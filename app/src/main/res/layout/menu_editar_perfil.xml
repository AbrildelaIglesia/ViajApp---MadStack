<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tarjetaEditarPerfil"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="22dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#B6C6E3"
    app:strokeWidth="2dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- VOLVER -->
            <TextView
                android:id="@+id/txtVolverMiCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹ Volver a mi cuenta"
                android:textColor="#2563EB"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingBottom="10dp" />

            <!-- TÍTULO -->
            <TextView
                android:id="@+id/txtTituloEditarPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar perfil"
                android:textColor="#111827"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- SUBTÍTULO -->
            <TextView
                android:id="@+id/txtSubtituloEditarPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Actualizá tus datos personales de forma simple y segura."
                android:textColor="#64748B"
                android:textSize="14sp" />

            <!-- SEPARADOR -->
            <View
                android:id="@+id/divisorEditarPerfilSuperior"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="#E2E8F0" />

            <!-- NOMBRE Y APELLIDO -->
            <TextView
                android:id="@+id/lblNombreApellidoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre y apellido"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/contenedorNombreApellidoPerfil"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="18dp"
                android:gravity="center_vertical"
                android:background="@null"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutNombreApellidoPerfil"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Nombre y apellido"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:endIconMode="none">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtNombreApellidoPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Escribí tu nombre y apellido"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:textColor="#111827"
                        android:textColorHint="#8493AA"
                        android:textSize="12sp"
                        android:inputType="textPersonName"
                        android:autofillHints="name"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:contentDescription="Nombre y apellido, campo de texto" />
                </com.google.android.material.textfield.TextInputLayout>

                <ImageView
                    android:id="@+id/btnMicNombreApellidoPerfil"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="Dictar nombre y apellido" />
            </LinearLayout>

            <!-- CORREO -->
            <TextView
                android:id="@+id/lblCorreoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Correo electrónico"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/contenedorCorreoPerfil"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:background="@null"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutCorreoPerfil"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Correo electrónico"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:endIconMode="none">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtCorreoPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Escribí tu correo electrónico"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:textColor="#111827"
                        android:textColorHint="#8493AA"
                        android:textSize="12sp"
                        android:inputType="textEmailAddress"
                        android:autofillHints="emailAddress"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:contentDescription="Correo electrónico, campo de texto" />
                </com.google.android.material.textfield.TextInputLayout>

                <ImageView
                    android:id="@+id/btnMicCorreoPerfil"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="Dictar correo electrónico" />
            </LinearLayout>

            <!-- BOTÓN -->

            <!-- TEXTO FINAL -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarEditarPerfil"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:text="Guardar cambios"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#2563EB"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_save"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="20dp"
                app:iconTint="#FFFFFF" />

            <TextView
                android:id="@+id/txtPieEditarPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Tus cambios se guardarán en tu cuenta de ViajAPP."
                android:textColor="#64748B"
                android:textSize="12sp"
                android:gravity="center" />

        </LinearLayout>
    </ScrollView>

</com.google.android.material.card.MaterialCardView>