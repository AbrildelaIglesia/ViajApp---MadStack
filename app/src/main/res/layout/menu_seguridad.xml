<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tarjetaSeguridad"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="22dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#B6C6E3"
    app:strokeWidth="2dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- VOLVER -->
            <TextView
                android:id="@+id/txtVolverSeguridad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:text="‹ Volver a mi cuenta"
                android:textColor="#2563EB"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- TÍTULO -->
            <TextView
                android:id="@+id/txtTituloSeguridad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seguridad"
                android:textColor="#111827"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- SUBTÍTULO -->
            <TextView
                android:id="@+id/txtSubtituloSeguridad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Protegé tu cuenta actualizando tu contraseña."
                android:textColor="#64748B"
                android:textSize="14sp" />

            <!-- SEPARADOR -->
            <View
                android:id="@+id/divisorSeguridad"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="#E2E8F0" />

            <!-- CONTRASEÑA ACTUAL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Contraseña actual"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/contenedorClaveActual"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="18dp"
                android:gravity="center_vertical"
                android:background="@null"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutClaveActual"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Contraseña actual"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:endIconMode="none">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtClaveActual"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Escribí tu contraseña actual"
                        android:inputType="textPassword"
                        android:autofillHints="password"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:textColor="#111827"
                        android:textColorHint="#8493AA"
                        android:textSize="12sp"
                        android:contentDescription="Contraseña actual, campo de texto seguro, obligatorio" />

                </com.google.android.material.textfield.TextInputLayout>

                <ImageView
                    android:id="@+id/btnToggleClaveActual"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/visible_false"
                    android:contentDescription="Mostrar contraseña actual" />

                <ImageView
                    android:id="@+id/btnMicClaveActual"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="Dictar contraseña actual" />

            </LinearLayout>

            <!-- CONTRASEÑA NUEVA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Nueva contraseña"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/contenedorClaveNueva"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="18dp"
                android:gravity="center_vertical"
                android:background="@null"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutClaveNueva"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Nueva contraseña"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:endIconMode="none">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtClaveNueva"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Escribí tu nueva contraseña"
                        android:inputType="textPassword"
                        android:autofillHints="newPassword"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:textColor="#111827"
                        android:textColorHint="#8493AA"
                        android:textSize="12sp"
                        android:contentDescription="Nueva contraseña, campo de texto seguro, obligatorio" />

                </com.google.android.material.textfield.TextInputLayout>

                <ImageView
                    android:id="@+id/btnToggleClaveNueva"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/visible_false"
                    android:contentDescription="Mostrar nueva contraseña" />

                <ImageView
                    android:id="@+id/btnMicClaveNueva"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="Dictar nueva contraseña" />

            </LinearLayout>

            <!-- CONFIRMAR CONTRASEÑA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Confirmar nueva contraseña"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/contenedorConfirmarClave"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:background="@null"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutConfirmarClave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Repetir nueva contraseña"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:endIconMode="none">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtConfirmarClave"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Repetí tu nueva contraseña"
                        android:inputType="textPassword"
                        android:autofillHints="newPassword"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:textColor="#111827"
                        android:textColorHint="#8493AA"
                        android:textSize="12sp"
                        android:contentDescription="Confirmar nueva contraseña, campo de texto seguro, obligatorio" />

                </com.google.android.material.textfield.TextInputLayout>

                <ImageView
                    android:id="@+id/btnToggleConfirmarClave"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/visible_false"
                    android:contentDescription="Mostrar confirmación de nueva contraseña" />

                <ImageView
                    android:id="@+id/btnMicConfirmarClave"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="Dictar confirmación de nueva contraseña" />

            </LinearLayout>

            <!-- RECOMENDACIÓN -->
            <TextView
                android:id="@+id/txtConsejoSeguridad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="La nueva contraseña debe tener al menos 8 caracteres, una mayúscula, una minúscula, un número y un carácter especial."
                android:textColor="#64748B"
                android:textSize="12sp" />

            <!-- BOTÓN GUARDAR -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarSeguridad"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:text="Actualizar contraseña"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#2563EB"
                app:cornerRadius="18dp" />

            <!-- TEXTO FINAL -->
            <TextView
                android:id="@+id/txtPieSeguridad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Por tu seguridad, verificaremos tu contraseña actual antes de realizar el cambio."
                android:textColor="#64748B"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

</com.google.android.material.card.MaterialCardView>