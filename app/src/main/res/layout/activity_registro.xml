<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pantallaRegistro"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- BARRA DE ACCESIBILIDAD FIJA -->
    <LinearLayout
        android:id="@+id/barraAccesibilidad"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/fondo_barra_accesibilidad"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ACCESIBILIDAD -->
        <TextView
            android:id="@+id/btnAccesibilidad"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text=" ☰  ACCESIBILIDAD"
            android:textColor="#1E5FA8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:contentDescription="Menú de accesibilidad"
            android:clickable="true"
            android:focusable="true" />

        <!-- DISMINUIR TEXTO -->
        <TextView
            android:id="@+id/btnDisminuirTexto"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="A-"
            android:textColor="#111827"
            android:textSize="12sp"
            android:textStyle="bold"
            android:contentDescription="Disminuir tamaño de letra"/>

        <!-- AUMENTAR TEXTO -->
        <TextView
            android:id="@+id/btnAumentarTexto"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="A+"
            android:textColor="#111827"
            android:textSize="16sp"
            android:textStyle="bold"
            android:contentDescription="Aumentar tamaño de letra"/>

        <!-- CONTRASTE -->
        <TextView
            android:id="@+id/btnContraste"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/fondo_boton_accesibilidad"
            android:text="◐  Contraste"
            android:textColor="#111827"
            android:textSize="11sp"
            android:textStyle="bold"
            android:contentDescription="Cambiar contraste de pantalla"/>

        <!-- AUDIO -->
        <TextView
            android:id="@+id/btnAudio"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/fondo_boton_audio"
            android:gravity="center"
            android:text="🔊"
            android:textSize="14sp"
            android:contentDescription="Cambiar lectura de pantalla por voz"/>

    </LinearLayout>


    <!-- CONTENIDO CON SCROLL -->
    <ScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/barraAccesibilidad"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp">

            <!-- LOGO VIAJAPP -->
            <ImageView
                android:id="@+id/imgLogoViajApp"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:background="@drawable/fondo_logo"
                android:padding="10dp"
                android:src="@drawable/logo_viajapp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <!-- TURISMO INCLUSIVO -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_shield_check"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Turismo 100% Inclusivo"
                    android:textColor="#0B1F3A"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- TITULO REGISTRO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:text="Crea tu cuenta en ViajAPP"
                android:textColor="#111827"
                android:textSize="16sp"/>

            <!-- DESCRIPCION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Planifica aventuras seguras, cómodas y sin&#10;barreras en cada destino."
                android:textColor="#111827"
                android:textSize="16sp"
                android:contentDescription="Planifica aventuras seguras, cómodas y sin barreras en cada destino."/>

            <!-- NOMBRE Y APELLIDOS - ENCABEZADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nombre y Apellidos *"
                    android:textColor="#111827"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Requerido"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:importantForAccessibility="no"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/contenedorNombre"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <EditText
                    android:id="@+id/etNombreApellidos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:drawableStart="@drawable/ic_person"
                    android:drawablePadding="10dp"
                    android:hint="Escribí tu nombre"
                    android:textColor="#111827"
                    android:textColorHint="#6B7280"
                    android:textSize="14sp"
                    android:inputType="textPersonName"
                    android:singleLine="true" />

                <!-- BOTÓN DE MICRÓFONO PARA NOMBRE -->
                <ImageView
                    android:id="@+id/btnMicNombre"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="Dictar nombre y apellidos"/>

            </LinearLayout>

            <!-- CORREO ELECTRÓNICO - ENCABEZADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Correo electrónico *"
                    android:textColor="#111827"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu correo activo"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:importantForAccessibility="no"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contenedorCorreo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <!-- BOTÓN DE MICRÓFONO PARA NOMBRE -->
                <EditText
                    android:id="@+id/etCorreo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:drawableStart="@drawable/ic_email"
                    android:drawablePadding="10dp"
                    android:hint="Escribí tu correo"
                    android:inputType="textPersonName"
                    android:singleLine="true"
                    android:textColor="#111827"
                    android:textColorHint="#6B7280"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btnMicCorreo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="Dictar correo electrónico"/>
            </LinearLayout>

            <!-- CONTRASEÑA - ENCABEZADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Contraseña *"
                    android:textColor="#111827"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mínimo 8 caracteres"
                    android:textColor="#111827"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- CAMPO CONTRASEÑA -->

            <!-- SEGURIDAD DE LA CONTRASEÑA -->
            <LinearLayout
                android:id="@+id/contenedorContrasena"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <EditText
                    android:id="@+id/etContrasena"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autofillHints="password"
                    android:background="@null"
                    android:contentDescription="Contraseña, campo de texto seguro, obligatorio"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawablePadding="10dp"
                    android:hint="Escribí tu contraseña"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="#111827"
                    android:textColorHint="#6B7280"
                    android:textSize="14sp" />

                <!-- BOTÓN MOSTRAR/OCULTAR CONTRASEÑA -->
                <ImageView
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:clickable="true"
                    android:contentDescription="Mostrar contraseña"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/visible_false" />

                <!-- BOTÓN DE MICRÓFONO PARA CONTRASEÑA -->
                <ImageView
                    android:id="@+id/btnMicContrasena"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:contentDescription="Dictar contraseña"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_mic" />
            </LinearLayout>

            <!-- CONFIRMAR CONTRASEÑA - ENCABEZADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Confirmar Contraseña *"
                    android:textColor="#111827"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Debe coincidir"
                    android:textColor="#111827"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- CAMPO CONFIRMAR CONTRASEÑA -->
            <LinearLayout
                android:id="@+id/contenedorConfirmarContrasena"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <EditText
                    android:id="@+id/etConfirmarContrasena"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawablePadding="10dp"
                    android:hint="Escribí nuevamente tu contraseña"
                    android:inputType="textPassword"
                    android:autofillHints="password"
                    android:singleLine="true"
                    android:textColor="#111827"
                    android:textColorHint="#6B7280"
                    android:textSize="14sp"
                    android:contentDescription="Confirmar contraseña, campo de texto seguro, obligatorio"/>

                <!-- BOTÓN MOSTRAR/OCULTAR CONTRASEÑA -->
                <ImageView
                    android:id="@+id/btnToggleConfPassword"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/visible_false"
                    android:contentDescription="Mostrar confirmación de contraseña" />

                <!-- BOTÓN DE MICRÓFONO PARA CONTRASEÑA -->
                <ImageView
                    android:id="@+id/btnMicConfirmacionContrasena"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="Dictar la confirmación de contraseña" />
            </LinearLayout>


            <!-- PREFERENCIAS DE ACCESIBILIDAD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="¿Cómo te adaptamos la experiencia?"
                    android:textColor="#111827"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- EXPLICACIÓN ACCESIBILIDAD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Personalizaremos rutas, transportes accesibles y audio-guías según tu selección."
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <!-- OPCIÓN SILLA DE RUEDAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_wheelchair"
                    android:importantForAccessibility="no"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Silla de ruedas y rampas prioritarias"
                    android:textColor="#111827"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbSillaRuedas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Seleccionar silla de ruedas y rampas prioritarias"/>

            </LinearLayout>

            <!-- OPCIÓN RECORRIDOS CORTOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_walk"
                    android:importantForAccessibility="no"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Recorridos cortos y descansos frecuentes"
                    android:textColor="#111827"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbRecorridosCortos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Seleccionar recorridos cortos y descansos frecuentes"/>

            </LinearLayout>

            <!-- OPCIÓN VISIÓN REDUCIDA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_visibility" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Visión reducida y TalkBack"
                    android:textColor="#111827"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbVisionReducida"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Seleccionar visión reducida y TalkBack"/>

            </LinearLayout>

            <!-- OPCIÓN SUBTÍTULOS Y AVISOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_hearing"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Subtítulos y avisos con vibración"
                    android:textColor="#111827"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbSubtitulos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Seleccionar subtítulos y avisos con vibración"/>

            </LinearLayout>

            <!-- OPCIÓN SIN ADAPTACIONES ESPECÍFICAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_travel_explore" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Sin adaptaciones específicas"
                    android:textColor="#111827"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbSinAdaptaciones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Seleccionar sin adaptaciones específicas"/>

            </LinearLayout>

            <!-- ACEPTACIÓN DE TÉRMINOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/cbTerminos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Aceptar términos y condiciones"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Acepto los términos de servicio y las políticas de turismo accesible."
                    android:textColor="#111827"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- BOTÓN CREAR CUENTA -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCrearCuenta"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/fondo_boton_crear_cuenta_estado"
                android:backgroundTint="@null"
                android:text="Crear Cuenta Accesible"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:drawableEnd="@drawable/ic_arrow_forward"
                android:drawablePadding="12dp"
                android:paddingEnd="24dp"
                android:paddingStart="24dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

            <!-- INFORMACIÓN DE PRIVACIDAD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_privacy"
                    android:importantForAccessibility="no"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp"
                    android:text="Tus datos están protegidos y las adaptaciones son 100% privadas."
                    android:textColor="#111827"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- YA TIENES UNA CUENTA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Ya tienes una cuenta? "
                    android:textColor="#4B5563"
                    android:textSize="14sp"
                    android:importantForAccessibility="no"/>

                <TextView
                    android:id="@+id/txtIniciarSesion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inicia sesión"
                    android:textColor="#1E5FA8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="¿Ya tienes una cuenta? Inicia sesión"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>